# 生产配置模板：复制为 deploy/.env.prod 后填写，不要提交真实值
APP_ENV=prod
# 正式 Release 镜像只接受 digest-pinned 引用；值来自 GitHub Release 的 manifest，禁止手填 tag。
# 示例：ghcr.io/<owner>/geo-backend@sha256:<64-hex-digest>
BACKEND_IMAGE=
FRONTEND_IMAGE=
SECRET_KEY=请替换为随机密钥
POSTGRES_DB=geo
POSTGRES_USER=geo
POSTGRES_PASSWORD=请替换为强密码
REDIS_PASSWORD=请替换为强密码
CORS_ORIGINS=https://geo.example.com
# 生产首次初始化管理员必须显式设置，脚本遇到空值会拒绝创建
SEED_ADMIN_USERNAME=geo_admin
SEED_ADMIN_PASSWORD=请替换为强密码
# editor/reviewer/lead_ops/viewer 四个联调账号共用；生产必须显式设置
SEED_USER_PASSWORD=请替换为强密码

# 证据对象存储（S3 兼容；四项齐全时启用，缺项回退本地 evidence_data 卷）
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=geo-evidence
S3_REGION=us-east-1
S3_SECURE=true

# 扩展 API 平台（Kimi / 千问 / 智谱 / 讯飞）
# 入口在种子数据中默认停用；先填 Key，再逐个 test-connection，通过后才考虑启用。
# 这些 host 只用于 openai_compatible 入口，不放开其它外网地址。
ENGINE_ALLOWED_HOSTS=api.moonshot.cn,dashscope.aliyuncs.com,open.bigmodel.cn,maas-api.cn-huabei-1.xf-yun.com
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
SPARK_API_KEY=

# 观测与告警（不填则用代码默认值；任务失败告警留空只写 JSON 日志）
QUEUE_BACKLOG_THRESHOLD=100
CELERY_DEFAULT_QUEUE=celery
LOG_LEVEL=INFO
TASK_ALERT_WEBHOOK=
# 告警风暴防护：同一时间窗内不同失败类（project_id + task_name + exception_type）最多逐类首报 N 类，超出只发一条汇总；0 表示不限流
TASK_ALERT_MAX_PER_WINDOW=5
TASK_ALERT_WINDOW_SECONDS=300
# 宿主机备份脚本读取（不由容器消费）：备份失败时的 webhook
BACKUP_ALERT_WEBHOOK=