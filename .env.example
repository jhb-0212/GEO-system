# ============================================================
# 复制本文件为 .env（不提交仓库），按本地情况调整
# 本文件所有值都是本地开发占位值，不含任何真实密钥或生产凭据
# ============================================================

# ---------- PostgreSQL（与 docker-compose.yml 保持一致） ----------
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo_dev
POSTGRES_DB=geo
# 5432 若被本机原生 PostgreSQL 占用，改成 5433 并同步下面的 DATABASE_URL
POSTGRES_PORT=5432

# 应用连接串（后端读取，不要在前端出现）
DATABASE_URL=postgresql+psycopg://geo:geo_dev@localhost:5432/geo

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Celery broker / result backend
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- 应用 ----------
APP_ENV=dev
API_BASE_URL=http://localhost:8000
# 后端密钥，本地随便填，生产必须重新生成
SECRET_KEY=change-me-in-dev

# ---------- 对象存储（首期本地可先用 MinIO 或跳过） ----------
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=geo-evidence
