# ============================================================
# 复制本文件为 .env（不提交仓库），按本地情况调整
# 本文件所有值都是本地开发占位值，不含任何真实密钥或生产凭据
# ============================================================

# ---------- PostgreSQL（与 docker-compose.yml 保持一致） ----------
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo_dev
POSTGRES_DB=geo
# 团队统一用 5433：容器专用端口，避开本机原生 PostgreSQL 默认占用的 5432
POSTGRES_PORT=5433

# 应用连接串（后端读取，不要在前端出现），端口必须与 POSTGRES_PORT 一致
DATABASE_URL=postgresql+psycopg://geo:geo_dev@localhost:5433/geo

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Celery broker / result backend
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 健康检查：队列积压阈值（/health/queue 超过即 503）
QUEUE_BACKLOG_THRESHOLD=100
CELERY_DEFAULT_QUEUE=celery

# 日志与告警
LOG_LEVEL=INFO
# 任务失败告警 webhook（留空则只写 JSON 错误日志）
TASK_ALERT_WEBHOOK=
# 告警风暴防护：同一时间窗内不同失败类（project_id + task_name + exception_type）最多逐类首报 N 类，超出只发一条汇总；0 表示不限流
TASK_ALERT_MAX_PER_WINDOW=5
TASK_ALERT_WINDOW_SECONDS=300

# ---------- 应用 ----------
APP_ENV=dev
API_BASE_URL=http://localhost:8000
# 后端密钥：APP_ENV 非 dev/local/test 时必须改成至少 32 位的随机值，否则启动直接报错
SECRET_KEY=change-me-in-dev
# 可信反代层数：0=直连，忽略 X-Forwarded-For；Nginx 单层前置时设为 1
TRUSTED_PROXY_COUNT=0
# 公开 FAQ 接口按来源 IP 每分钟的请求上限（<=0 表示关闭限流）
PUBLIC_FAQ_PER_MINUTE=30
# openai_compatible 入口额外允许的 host（逗号分隔）；官方 provider host 默认已允许
# 2026-11-18 接入的 4 个平台示例（按需取用，不要留空项）：
#   Kimi   api.moonshot.cn
#   千问   dashscope.aliyuncs.com
#   智谱   open.bigmodel.cn
#   讯飞   maas-api.cn-huabei-1.xf-yun.com（星辰 MaaS 新版；旧版 spark-api-open.xf-yun.com）
ENGINE_ALLOWED_HOSTS=api.moonshot.cn,dashscope.aliyuncs.com,open.bigmodel.cn,maas-api.cn-huabei-1.xf-yun.com

# ---------- 平台 OAuth（第三方平台授权，通用框架） ----------
# provider 配置二选一：JSON 文件路径，或直接写 JSON 数组
OAUTH_PROVIDERS_FILE=
OAUTH_PROVIDERS_JSON=
OAUTH_STATE_EXPIRE_MINUTES=10
OAUTH_HTTP_TIMEOUT_SECONDS=10.0
OAUTH_FRONTEND_BASE_URL=http://localhost:3000
# 平台回调基地址；留空回退 API_BASE_URL
OAUTH_CALLBACK_BASE_URL=http://localhost:8000

# ---------- 微信公众号官方发布 ----------
# 公众号后台「设置与开发 → 基本配置」拿 AppID；AppSecret 只放服务端，不要提交
WECHAT_MP_APP_ID=
# 账号的 credential_ref 必须指向这个变量名；程序先读进程环境，再回落到本文件白名单键
WECHAT_MP_SECRET_KEY=
# 渠道 code，默认与种子数据的「微信公众号」一致
WECHAT_MP_CHANNEL_CODE=wechat-mp
WECHAT_MP_API_BASE_URL=https://api.weixin.qq.com
WECHAT_MP_TIMEOUT_SECONDS=10.0
# 可选：作者名与默认封面永久素材 ID（公众号发布通常需要封面）
WECHAT_MP_AUTHOR=
WECHAT_MP_DEFAULT_THUMB_MEDIA_ID=

# ---------- 种子账号 ----------
# 生产环境必须显式设置两个密码；本地留空会使用开发默认口令
SEED_ADMIN_USERNAME=geo_admin
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# ---------- 对象存储（S3 兼容；四项齐全时证据文件走对象存储，否则落本地 evidence_root） ----------
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=geo-evidence
S3_REGION=us-east-1
S3_SECURE=false

# ---------- 本地模型 smoke（仅开发验证，不是正式 AI 平台） ----------
# 只用于验证采集链/解析/状态机，不进入 4 平台业务基线
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_API_KEY=
LOCAL_SMOKE_DATABASE_URL=postgresql+psycopg://geo:geo_dev@localhost:5433/geo_local_smoke

# ---------- AI 平台入口密钥（只配进程环境或本文件，真实值不要提交） ----------
# 入口的 credential_ref 填这里的变量名；程序先读进程环境，再回落到本文件白名单键。
# DeepSeek：Responses 服务端联网工具（deepseek_web_search）
DEEPSEEK_API_KEY=
# 豆包：火山方舟 Responses API + web_search
ARK_API_KEY=
# 百度文心：千帆 ERNIE 对话模型
QIANFAN_API_KEY=
# 腾讯元宝：SearchPro（TC3 签名，两个都要）
YUANBAO_SECRET_ID=
YUANBAO_SECRET_KEY=
# 扩展 / 探测 API 平台（入口默认停用，填 Key 后再 test-connection）
# Kimi：Moonshot OpenAI-compatible
MOONSHOT_API_KEY=
# 千问：百炼 OpenAI-compatible
DASHSCOPE_API_KEY=
# 智谱：BigModel OpenAI-compatible
ZHIPU_API_KEY=
# 讯飞：星辰 MaaS OpenAI-compatible
SPARK_API_KEY=

# 客户配额告警外发：留空只写审计与日志；format=feishu 按飞书机器人 text 消息包装
QUOTA_ALERT_WEBHOOK=
QUOTA_ALERT_FORMAT=generic
# 仅开发/测试：API 入口用确定性假引擎跑通链路；生产环境启动时会被拒绝
MONITORING_FAKE_ENGINE_ENABLED=false
